# Backend environment variables (set these on Render, or export them before ./mvnw spring-boot:run)

# --- Database (required) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eventdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# --- JWT (optional, has a default for local use) ---
JWT_SECRET=a-long-random-string-of-at-least-64-characters
JWT_EXPIRATION=86400000

# --- First admin account, created on startup if missing (optional) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Frontend URLs allowed to call the API (comma separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://eventbook-ek9t.onrender.com

# --- Demo data (movies, cinemas, shows, demo users) on an empty database ---
DEMO_DATA_ENABLED=true
DEMO_PASSWORD=Demo@1234
